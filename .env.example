ANTHROPIC_API_KEY=
QUIVERAI_API_KEY=

# Stable public MCP URL (optional). Create a tunnel in Cloudflare Zero Trust → Networks → Tunnels,
# add a public hostname that points to http://127.0.0.1:29980, then paste its token and hostname here.
# Without these, Connect falls back to a temporary *.trycloudflare.com URL that changes every launch.
VANTA_TUNNEL_TOKEN=
VANTA_PUBLIC_URL=

# Optional fixed MCP token. Leave empty to use the one Scobe generates in ~/.vanta/mcp-token.
VANTA_MCP_TOKEN=

# Development override only. Public release URL is in src/shared/cloudConfig.json.
SCOBE_AI_GATEWAY_URL=
