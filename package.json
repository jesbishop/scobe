{
  "name": "vanta",
  "productName": "Vanta",
  "version": "0.1.0",
  "description": "Vanta design canvas with live browsers and an MCP server for coding agents.",
  "author": "Jesse Bishop",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --publish always"
  },
  "build": {
    "appId": "com.vanta.app",
    "productName": "Vanta",
    "directories": {
      "output": "release/${version}",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@imgly/background-removal-node/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "jesbishop",
      "repo": "vanta",
      "releaseType": "release"
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis"
      ],
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/{darwin,linux}/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Vanta-Setup.${ext}"
    },
    "mac": {
      "icon": "resources/icon.png",
      "artifactName": "Vanta-mac-${arch}.${ext}",
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ],
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/{win32,linux}/**"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Graphics",
      "artifactName": "Vanta-linux-${arch}.${ext}",
      "target": [
        "AppImage"
      ],
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/{win32,darwin}/**"
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@huggingface/transformers": "^3.8.1",
    "@imgly/background-removal-node": "^1.4.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@quiverai/sdk": "^0.9.4",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "ws": "^8.18.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/google-sans": "^5.3.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@paper-design/shaders-react": "0.0.80",
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "lucide-react": "^1.57.0",
    "motion": "^13.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
