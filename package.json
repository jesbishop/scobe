{
  "name": "vanta",
  "productName": "Scobe",
  "version": "0.2.2",
  "description": "Scobe design canvas with live browsers and an MCP server for coding agents.",
  "author": "Jesse Bishop",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/build-icon-index.mjs",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --publish always",
    "predist": "node scripts/check-cloud-release.mjs",
    "predist:win": "node scripts/check-cloud-release.mjs",
    "prerelease": "node scripts/check-cloud-release.mjs",
    "test:canvas-agent": "node --test server/canvas-agent.test.mjs",
    "test:gateway": "node --test server/ai-gateway.test.mjs server/cloud-session.test.mjs"
  },
  "build": {
    "appId": "com.vanta.app",
    "productName": "Scobe",
    "directories": {
      "output": "release/${version}",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@imgly/background-removal-node/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "jesbishop",
      "repo": "scobe",
      "releaseType": "release"
    },
    "win": {
      "icon": "resources/icon-1024.png",
      "target": [
        "nsis"
      ],
      "files": [
        "out/**/*",
        "resources/**/*",
        "package.json",
        "!**/.env",
        "!**/.env.*",
        "!node_modules/onnxruntime-node/bin/napi-v3/{darwin,linux}/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Scobe-Setup.${ext}"
    },
    "mac": {
      "icon": "resources/icon-1024.png",
      "artifactName": "Scobe-mac-${arch}.${ext}",
      "category": "public.app-category.graphics-design",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Scobe uses the microphone so you can talk in chat."
      },
      "target": [
        "dmg",
        "zip"
      ],
      "files": [
        "out/**/*",
        "resources/**/*",
        "package.json",
        "!**/.env",
        "!**/.env.*",
        "!node_modules/onnxruntime-node/bin/napi-v3/{win32,linux}/**"
      ]
    },
    "linux": {
      "icon": "resources/icon-1024.png",
      "category": "Graphics",
      "artifactName": "Scobe-linux-${arch}.${ext}",
      "target": [
        "AppImage"
      ],
      "files": [
        "out/**/*",
        "resources/**/*",
        "package.json",
        "!**/.env",
        "!**/.env.*",
        "!node_modules/onnxruntime-node/bin/napi-v3/{win32,darwin}/**"
      ]
    },
    "electronDownload": {
      "cache": ".build-cache/electron"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@huggingface/transformers": "^3.8.1",
    "@imgly/background-removal-node": "^1.4.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@quiverai/sdk": "^0.9.4",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "ws": "^8.18.3",
    "zod": "^4.6.4"
  },
  "overrides": {
    "onnxruntime-node": "1.21.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/google-sans": "^5.3.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@paper-design/shaders-react": "0.0.80",
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "lucide-react": "^1.57.0",
    "motion": "^13.2.0",
    "pngjs": "^7.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
